# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Maps
NEXT_PUBLIC_MAP_STYLE_URL=

# Locale
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# Payments (server-only)
PAYMENT_AGGREGATOR_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Mock backend (apps/web) — used while NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_USE_MOCKS=true
# Admin console login for the mock backend (defaults: admin@gobert.cm / admin123 — change outside local dev)
GOBERT_ADMIN_EMAIL=
GOBERT_ADMIN_PASSWORD=
# Seeded demo riders auto-accept trips after 15 s so one person can demo the customer flow. Set to false to disable.
GOBERT_AUTOPILOT=true
# Persist mock data to apps/web/.mock-data (set false on read-only hosts)
GOBERT_MOCK_PERSIST=true

# Admin app -> web mock API base URL
NEXT_PUBLIC_WEB_API_URL=http://localhost:3000

# Admin console (apps/admin)
# Secret URL path — required for production builds, e.g. /ops-k3v9x2q7m1z8
ADMIN_BASE_PATH=
# Optional: only these IPs / IPv4 CIDR ranges can reach the admin console
ADMIN_ALLOWED_IPS=
# Optional: your own OSRM routing server
NEXT_PUBLIC_OSRM_URL=

# Cloudflare Turnstile (public site key). The secret key goes only into Supabase → Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
